# --- Google Cloud & Vertex AI (ADC) Configuration ---
GOOGLE_CLOUD_PROJECT=elevate-data-508005
# NOTE on data residency: `global` routes inference to the nearest available
# region, which may be outside the jurisdiction of a regulated entity. For a
# Singapore-supervised institution set this to asia-southeast1 and confirm the
# chosen Gemini model is served there.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.8-flash

# --- Spanner & GCS Configuration ---
SPANNER_INSTANCE=ai-kyc-instance
SPANNER_DATABASE=kyc-db
GCS_BUCKET_NAME=kyc-content-storage

# --- Secrets (Stored in Google Cloud Secret Manager; fetched automatically via ADC) ---
# Set locally ONLY for offline development. Never commit real values.
# GOOGLE_CSE_ID=
# GOOGLE_SEARCH_API_KEY=
# SB_API_KEY=

# --- Identity ---
# Subject-id namespace. Two institutions sharing a deployment must not share a
# subject namespace, or one bank's adverse media lands on the other's customer.
KYC_TENANT_ID=default

# --- Diligence-tier query budgets ---
# Caps Custom Search spend per subject. Enforced in code, not just requested in
# the prompt, so an over-generating model cannot exhaust the daily quota.
KYC_QUERIES_STANDARD=25
KYC_QUERIES_ENHANCED=100
KYC_QUERIES_MONITORING=10

# --- Custom Search quota guardrails ---
# NOTE: these counters are per-process. Under `gunicorn -w 4` the effective
# ceiling is 4x the configured value. Set accordingly or move the counter to
# Spanner/Redis before relying on it as a hard limit.
KYC_SEARCH_DAILY_LIMIT=10000
KYC_SEARCH_MAX_QPS=8

# --- Perpetual KYC (pKYC) monitoring cadence, in days ---
# "unknown" covers subjects whose last run was fail-closed. They have NOT been
# screened, so they are re-screened at the tightest cadence, not the loosest.
KYC_MONITOR_DAYS_HIGH=1
KYC_MONITOR_DAYS_MEDIUM=7
KYC_MONITOR_DAYS_LOW=30
KYC_MONITOR_DAYS_UNKNOWN=1
KYC_MONITOR_MAX_SUBJECTS=200
KYC_MONITOR_WORKERS=3

# --- Task endpoint authentication ---
# Comma-separated service accounts permitted to call /api/worker/push and
# /api/tasks/pkyc-sweep. Empty means reject everything, which is the correct
# default. Populated automatically by deploy.sh once the service URL is known.
KYC_ALLOWED_INVOKER_SAS=
# Must equal the Cloud Run service URL: the OIDC token audience is checked
# against it, so a mismatch rejects every legitimate task invocation.
KYC_OIDC_AUDIENCE=
# Local development escape hatch. Refuses to activate when K_SERVICE is set,
# i.e. it can never disable auth on Cloud Run.
KYC_ALLOW_UNAUTHENTICATED_TASKS=false

# --- Document upload limits ---
KYC_MAX_UPLOAD_BYTES=20971520

# --- Pub/Sub ---
KYC_PUBSUB_TOPIC=kyc-batch-jobs