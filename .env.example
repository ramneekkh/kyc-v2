# Set USE_CLOUD_SQL to 'true' to use PostgreSQL, or 'false' to use SQLite
USE_CLOUD_SQL=false

# --- PostgreSQL (Cloud SQL) Configuration (only needed if USE_CLOUD_SQL is true) ---
# Replace with your actual Cloud SQL database credentials and instance details
DB_USER=dbuser
DB_PASSWORD=password
DB_NAME=postgres

# --- SQLite Configuration (only needed if USE_CLOUD_SQL is false) ---
# Default to a local SQLite file
# DATABASE_URL=sqlite:///site.db

# --- Google API Key for Generative AI (needed for both database types) ---
GOOGLE_API_KEY=yourkey

# --- Google Custom Search API Keys (needed for both database types) ---
GOOGLE_CSE_ID=yourkey